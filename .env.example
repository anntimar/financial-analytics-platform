APP_NAME=FinAnalytics
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=finanalytics
POSTGRES_USER=finanalytics_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://finanalytics_user:change_me@postgres:5432/finanalytics

API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_URL=http://api:8000/api/v1
